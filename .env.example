# Copiez ce fichier vers .env si vous voulez modifier la configuration.
# PAR DÉFAUT, AUCUNE CONFIGURATION N'EST NÉCESSAIRE : le système utilise votre
# session Claude Code / Claude Desktop locale (authentification par abonnement,
# aucune clé API). Ne commitez jamais .env.

# Fournisseur LLM : auto (défaut) | claude-session | claude-cli | anthropic | mock
#  - auto           : claude-session
#  - claude-session : VOTRE session Claude Code exécute chaque étape via le pont agent
#                     (aucune clé API, aucun sous-processus ; lancez `npm run bridge` dans la session)
#  - claude-cli     : sous-processus headless `claude -p` (même abonnement, sans supervision)
#  - anthropic      : API Anthropic (nécessite ANTHROPIC_API_KEY)
#  - mock           : données factices, pour explorer l'interface sans rien consommer
# Modifiable à chaud depuis l'interface (sélecteur « Moteur »).
LLM_PROVIDER=auto

# --- Réglages pont agent (claude-session) ---
# Temps maximum d'attente d'une réponse de votre session Claude, par étape (ms)
CLAUDE_SESSION_TIMEOUT_MS=2700000

# --- Réglages CLI headless (claude-cli) ---
# Modèle de la session (vide = modèle par défaut de votre session ; alias acceptés : opus, sonnet, haiku)
CLAUDE_CLI_MODEL=
# Nombre maximum d'appels claude simultanés (la pipeline en parallélise jusqu'à 4)
CLAUDE_CLI_CONCURRENCY=2
# Timeout par étape en millisecondes
CLAUDE_CLI_TIMEOUT_MS=900000
# Mettre à true pour ignorer la CLI claude même si elle est installée
CLAUDE_CLI_DISABLED=false

# --- Réglages API Anthropic (uniquement si LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=high
LLM_FALLBACKS=true

# --- Mode mock ---
# Latence simulée par étape, en ms (défaut 300). Montez-la à ~1500 pour regarder
# la pipeline avancer étape par étape dans l'interface.
MOCK_DELAY_MS=300

# Recherche entreprise : auto (défaut, via le provider LLM actif) | none
RESEARCH_PROVIDER=auto

# Port du serveur local
PORT=3777
